// The playground: one Worker that serves the page and runs Lyra (issue #60, slice 1).
//
// The page is served from this Worker's static assets, so a browser talks to one
// origin and there is no CORS and no second deployment. `/v1/*` is handed to the
// session object by `run_worker_first`, because the assets layer would otherwise
// answer a protocol route with the page's `index.html`.
{
	"name": "lyra-playground",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	// The tenant is a var because it is not a secret; the token is a Worker secret, so
	// it is never in this file. `wrangler dev` reads it from `.dev.vars`. Both are
	// prefixed, because the `gw secret` vault is shared and a name there says which
	// project it belongs to (issue #60, slice 2).
	"vars": {
		"LYRA_PLAYGROUND_TENANT": "playground",
		// The day's cap in dollars (issue #60, slice 7). A var rather than a secret: it is
		// a policy number, and the page shows it. Unset would mean no cap.
		"LYRA_PLAYGROUND_DAY_CAP_USD": "1",
	},
	"assets": {
		// The SvelteKit app, built by `pnpm build` into this directory. `public/` held
		// slice 1's placeholder page and is gone.
		"directory": "./dist/web",
		"not_found_handling": "single-page-application",
		// `/v1/*` is the protocol; `/api/*` is the playground's own sidebar and recipe
		// list (issue #60, slice 3). Both have to reach this Worker, because the
		// single-page fallback would otherwise answer them with the page.
		"run_worker_first": ["/v1/*", "/api/*"],
	},
	"durable_objects": {
		"bindings": [
			{ "name": "SESSION", "class_name": "Session" },
			// One index object per tenant, holding the conversation list (decision 158).
			{ "name": "INDEX", "class_name": "SessionIndex" },
			// One budget object per tenant, holding the day's spend (decision 161).
			{ "name": "BUDGET", "class_name": "Budget" },
		],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Session"] },
		{ "tag": "v2", "new_sqlite_classes": ["SessionIndex"] },
		{ "tag": "v3", "new_sqlite_classes": ["Budget"] },
	],
}
