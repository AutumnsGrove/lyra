// A Worker with one Durable Object that runs Lyra (docs/implementation/04-cloudflare-adapter.md).
//
// It is never deployed: CI builds it with `wrangler deploy --dry-run`, which bundles
// it exactly as a real deploy would and stops before touching an account. That is
// the check that the library stays embeddable, and the bundle it leaves behind is
// what the size budget measures.
{
	"name": "lyra-workers-minimal",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// A local-only token and tenant, so `pnpm dev` needs no secret. A real host reads
	// both from secret bindings.
	"vars": { "LYRA_TOKEN": "dev-token", "LYRA_TENANT": "example" },
	"durable_objects": {
		"bindings": [{ "name": "SESSION", "class_name": "Session" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
}
