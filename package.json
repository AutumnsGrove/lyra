{
	"name": "lyra-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "A small, portable agent core for Grove",
	"license": "MIT",
	"author": "Autumn Brown <autumn@grove.place>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AutumnsGrove/lyra.git"
	},
	"type": "module",
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build": "pnpm --filter @autumnsgrove/lyra build",
		"test": "vitest run",
		"test:watch": "vitest",
		"fuzz": "vitest run --config vitest.fuzz.config.ts",
		"importcheck": "node scripts/importcheck.mjs",
		"matrixcheck": "node scripts/matrixcheck.mjs",
		"budget": "node scripts/budget.mjs",
		"coverage": "vitest run --coverage",
		"ci": "pnpm format && pnpm typecheck && pnpm build && pnpm test && pnpm fuzz && pnpm importcheck && pnpm matrixcheck && pnpm budget && pnpm coverage"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^5.1.0",
		"prettier": "^3.10.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
